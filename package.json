{
  "name": "open-laser-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source laser design and motion-control studio (xTool F1 first, cylindrical engraving focus)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:native": "pnpm --filter @ols/desktop build:native",
    "dev": "pnpm --filter @ols/desktop dev",
    "build": "pnpm --filter @ols/desktop build",
    "package": "pnpm --filter @ols/desktop package",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "test": "pnpm test:rust && pnpm test:js && pnpm test:firmware",
    "test:rust": "cargo test --workspace",
    "test:js": "vitest run",
    "test:firmware": "node scripts/test-firmware-host.mjs",
    "test:e2e": "pnpm --filter @ols/desktop test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
