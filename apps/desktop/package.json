{
  "name": "@ols/desktop",
  "productName": "Open Laser Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Open Laser Studio desktop application",
  "license": "MIT",
  "author": "Open Laser Studio contributors",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build:native": "node ../../scripts/build-native.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "package": "node ../../scripts/build-native.mjs && electron-vite build && electron-builder --config electron-builder.yml",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ols/geometry-adapters": "workspace:*",
    "@ols/ipc-contracts": "workspace:*",
    "@ols/shared-types": "workspace:*",
    "@ols/ui": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "konva": "^10.9.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
